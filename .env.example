# sum_agent configuration. Copy to .env and edit. All keys are SUM_AGENT_-prefixed.

# Where the agent talks to (sum_server or a sum_satellite).
SUM_AGENT_SERVER_URL=https://sum-server.example.com:8443

# Where persistent state (agent token, server pubkey) lives. Mode 0600.
SUM_AGENT_STATE_DIR=~/.local/state/sum-agent

# How often to refresh the inventory snapshot.
SUM_AGENT_INVENTORY_INTERVAL_SECONDS=3600

# How often to heartbeat (presence signal).
SUM_AGENT_HEARTBEAT_INTERVAL_SECONDS=30

# Apply server-signed self-update directives (frozen binary only). The agent
# reverts to the previous binary if a new one can't establish itself within
# the verify window.
SUM_AGENT_SELF_UPDATE_ENABLED=true
SUM_AGENT_SELF_UPDATE_VERIFY_SECONDS=120

# Logging.
SUM_AGENT_LOG_LEVEL=info             # debug|info|warning|error
SUM_AGENT_LOG_FORMAT=console         # console|json

# Dev only: skip TLS verification. Refused for non-localhost URLs.
SUM_AGENT_TLS_INSECURE=false
